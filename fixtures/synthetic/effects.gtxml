<Composition Width="400" Height="200">
  <Layer Name="Layer 1" Dimensions="400,200,0">
    <Layer.Composition>
      <Composition Width="400" Height="200">
        <Rectangle Name="ShadowBox" Dimensions="120,60,0" Location="20,20,0" Opacity="0.5" CompositingMode="Additive">
          <Rectangle.Fill>
            <Brush Color="#FFFFAA00"/>
          </Rectangle.Fill>
          <Rectangle.Effects>
            <Effect Type="Shadow" BlurAmount="9" Mode="Shadow"/>
            <Effect Type="Skew" Angle="10,0"/>
          </Rectangle.Effects>
        </Rectangle>
        <Image Name="Cropped" Dimensions="100,100,0" Location="160,20,0" SizeMode="Centered">
          <Image.Crop>
            <Crop Feather="0,0,0,0" Range="0.1,0.1,0.9,0.9"/>
          </Image.Crop>
          <Image.Bitmap>
            <Bitmap Source="tiny.png"/>
          </Image.Bitmap>
        </Image>
        <TextBlock Name="Masked" Dimensions="100,40,0" Location="20,100,0" Text="HI" FontFamily="Arial" FontSize="20">
          <TextBlock.Mask>
            <Mask Object="Cropped"/>
          </TextBlock.Mask>
          <TextBlock.Fill>
            <Brush Color="#FFFFFFFF"/>
          </TextBlock.Fill>
        </TextBlock>
      </Composition>
    </Layer.Composition>
  </Layer>
</Composition>
